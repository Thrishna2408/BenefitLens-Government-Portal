# BenefitLens Backend Environment Configuration
PROJECT_NAME="BenefitLens: Transparent Government Benefit Disbursement Tracker"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL running on port 12345)
DATABASE_URL=postgresql://postgres:12345@127.0.0.1:12345/benefit_govt_db
DB_FALLBACK_SQLITE=False

# JWT Secret & Security
JWT_SECRET=your_super_secret_benefitlens_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMS Gateway Configuration
SMS_GATEWAY_PROVIDER=simulated
SMS_GATEWAY_API_KEY=your_sms_key_here
SMS_SENDER_ID=BNFLNS

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
